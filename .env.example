APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:8082

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=moonery
DB_USERNAME=root
DB_PASSWORD=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Customer assistant (chat). The free tier of the provider may use inputs and outputs
# to improve its models: in development use ONLY seeded data, never real customers.
ASSISTANT_ENABLED=
ASSISTANT_PROVIDER=
ASSISTANT_MODEL=
ASSISTANT_BOT_EMAIL=
ASSISTANT_MAX_ITERATIONS=
ASSISTANT_MAX_OUTPUT_TOKENS=
ASSISTANT_TIMEOUT_SECONDS=
ASSISTANT_RUN_DEADLINE_SECONDS=
ASSISTANT_MAX_INPUT_CHARS=
ASSISTANT_HISTORY_MESSAGES=
ASSISTANT_USER_MAX_RUNS=
ASSISTANT_USER_WINDOW_SECONDS=
ASSISTANT_DAILY_TOKEN_CAP=
ASSISTANT_CONFIRMATION_TTL_MINUTES=

GEMINI_API_KEY=
GEMINI_BASE_URL=
ASSISTANT_GEMINI_MIN_INTERVAL_MS=
ASSISTANT_GEMINI_MAX_RETRIES=
ASSISTANT_GEMINI_DAILY_CAP=
ASSISTANT_GEMINI_RESPECT_RETRY_AFTER=
ASSISTANT_GEMINI_RESET_TIMEZONE=

# Messaging retry ladder (emails.queue, assistant.queue)
MESSAGING_RETRY_TIER_1_MS=
MESSAGING_RETRY_TIER_2_MS=
MESSAGING_RETRY_TIER_3_MS=
